{
    "manifest_version": 3,
    "name": "UPC Finder",
    "version": "1.0",
    "description": "Locate and display UPC from a product page with a copy button.",
    "permissions": [
      "activeTab"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["https://www.walmart.com/*", "https://www.amazon.com/*"],
        "js": ["content.js"]
      }
    ],
    "icons": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
  